				{
					"name": "List Exercises",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Returns array with at least 2 exercises', function () {",
									"    const exercises = pm.response.json();",
