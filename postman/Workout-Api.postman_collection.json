{
	"info": {
		"_postman_id": "workout-api-collection",
		"name": "Workout API",
		"description": "Collection completa para testar a Workout API.\n\n## Como usar\n1. Suba a API: `./mvnw spring-boot:run`\n2. (Opcional) Suba o Mailpit para e-mails: `docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit`\n3. Importe esta collection no Postman\n4. Execute as pastas na ordem recomendada abaixo\n\n## Ordem recomendada\n1. `01 - Auth`\n2. `03 - Exercises`\n3. `04 - Workout Plans`\n4. `02 - Users` (cole `resetToken` do Mailpit antes do Reset Password)\n\n## Variáveis da collection\n- `baseUrl` — URL base da API\n- `email`, `password` — credenciais de teste (`email` é gerado automaticamente no cadastro)\n- `token`, `userId`, `exerciseId`, `exerciseId2`, `planId`, `resetToken` — preenchidas pelos scripts de teste",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "email",
			"value": "lucas@email.com"
		},
		{
			"key": "password",
			"value": "secret123"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "exerciseId",
			"value": ""
		},
		{
			"key": "exerciseId2",
			"value": ""
		},
		{
			"key": "planId",
			"value": ""
		},
		{
			"key": "resetToken",
			"value": ""
		}
	],
	"item": [
		{
			"name": "01 - Auth",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.collectionVariables.set('email', `user${Date.now()}@email.com`);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('userId', json.id);",
									"    pm.test('Response has user id', function () {",
									"        pm.expect(json.id).to.be.a('number');",
									"    });",
									"    pm.test('Password not exposed', function () {",
									"        pm.expect(json.password).to.be.undefined;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Lucas Silva\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fitnessLevel\": \"FIT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Cadastra um novo usuário. Endpoint público."
					}
				},
				{
					"name": "Register User - Invalid Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Teste\",\n  \"email\": \"email-invalido\",\n  \"password\": \"secret123\",\n  \"fitnessLevel\": \"FIT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Testa validação de e-mail inválido."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.accessToken);",
									"    pm.test('Access token received', function () {",
									"        pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica e salva o JWT na variável `token`."
					}
				},
				{
					"name": "Login - Invalid Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test('Generic error message', function () {",
									"    pm.expect(pm.response.json().error).to.eql('Invalid e-mail or password.');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"senha-errada\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Testa login com senha incorreta."
					}
				},
				{
					"name": "Protected Endpoint Without Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 403 Forbidden', function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/exercises",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"exercises"
							]
						},
						"description": "Confirma que endpoints protegidos bloqueiam acesso sem JWT."
					}
				}
			]
		},
		{
			"name": "02 - Users",
			"item": [
				{
					"name": "Update User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('User updated with ATHLETE level', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json.name).to.eql('Lucas Atualizado');",
									"    pm.expect(json.fitnessLevel).to.eql('ATHLETE');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Lucas Atualizado\",\n  \"fitnessLevel\": \"ATHLETE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Atualiza dados do usuário. Requer JWT."
					}
				},
				{
					"name": "Forgot Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Generic response message', function () {",
									"    pm.expect(pm.response.text()).to.include('password reset e-mail has been sent');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"forgot-password"
							]
						},
						"description": "Solicita reset de senha. Se Mailpit estiver rodando, veja o token em http://localhost:8025 e cole em `resetToken`."
					}
				},
				{
					"name": "Forgot Password - Unknown Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK (same generic message)', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Generic response message', function () {",
									"    pm.expect(pm.response.text()).to.include('password reset e-mail has been sent');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"desconhecido@test.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"forgot-password"
							]
						},
						"description": "Mesma resposta genérica para e-mail inexistente (segurança)."
					}
				},
				{
					"name": "Reset Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.set('password', 'newpass456');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"newpass456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"reset-password"
							]
						},
						"description": "Altera a senha com o token do e-mail. Atualiza a variável `password` para `newpass456`."
					}
				},
				{
					"name": "Login After Reset Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.set('token', pm.response.json().accessToken);",
									"    pm.test('New password works', function () {",
									"        pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Confirma login com a nova senha e atualiza `token`."
					}
				},
				{
					"name": "Reset Password - Invalid Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test('Invalid token error', function () {",
									"    pm.expect(pm.response.json().error).to.eql('Invalid token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resetToken\": \"token-invalido\",\n  \"newPassword\": \"newpass456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"reset-password"
							]
						},
						"description": "Testa token de reset inválido."
					}
				},
				{
					"name": "Delete User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 204 No Content', function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Remove o usuário. Execute por último na pasta Users."
					}
				}
			]
		},
		{
			"name": "03 - Exercises",
			"description": "CRUD completo de exercícios. Execute após `01 - Auth`. Os deletes ficam ao final de `04 - Workout Plans` para não quebrar o fluxo do plano.",
			"item": [
				{
					"name": "Create Exercise",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('exerciseId', json.id);",
									"    pm.test('Response has exercise DTO fields', function () {",
									"        pm.expect(json.id).to.be.a('number');",
									"        pm.expect(json.name).to.eql('Agachamento');",
									"        pm.expect(json.description).to.eql('Exercício para pernas');",
									"        pm.expect(json.workoutPlans).to.be.undefined;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Agachamento\",\n  \"description\": \"Exercício para pernas\"\n}"
