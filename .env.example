# Copy this file to .env and fill out values

JWT_SECRET=your_32_characters_or_more_secret_key_here
JWT_EXPIRATION=86400000

# SMTP settings (Mailpit/MailHog default: localhost:1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@workout-api.local
